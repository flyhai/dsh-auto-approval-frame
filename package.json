{
  "name": "dsh-auto-approval-frame",
  "version": "0.6.0",
  "description": "Four-tier interception and audit frame for DeepSeek Harness: deterministic facts and editable rules (deny / ask / AI / allow), AI review, human approval, automatic masking of secrets in tool results with a local reversible token vault, and every event in a hash-chained, day-segmented audit store",
  "icon": "./assets/icon.svg",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyhai/dsh-auto-approval-frame.git"
  },
  "homepage": "https://github.com/flyhai/dsh-auto-approval-frame#readme",
  "bugs": {
    "url": "https://github.com/flyhai/dsh-auto-approval-frame/issues"
  },
  "author": "flyhai",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "approval",
    "security",
    "audit"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./lib/client.js"
  },
  "scripts": {
    "test": "node test/frame.test.mjs && node test/wiring.test.mjs && node test/client.test.mjs"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/frame/*.js",
    "cordis.patch.yml",
    "locale",
    "assets/icon.svg",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <2",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <2",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <2",
    "@deepseek-ai/dsh-permission-presets": ">=0.2.1-rc.2 <2",
    "@deepseek-ai/dsh-user-approval": ">=0.2.1-rc.2 <2",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-permission-presets": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
